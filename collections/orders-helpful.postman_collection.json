  "item": [
    {
      "name": "Get order",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/ord_123",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "ord_123"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"GET /orders/{id} returns 'orderId'\", function () {",
              "  pm.expect(",
              "    pm.response.json(),",
              "    \"Response is missing 'orderId'. The OpenAPI spec defines it as a required string.\"",
              "  ).to.have.property(\"orderId\");",
              "});"
            ]
          }
        }
      ],
      "id": "89af92b2-ad98-4257-96bf-2efa39c522ec"
    }
  ]
